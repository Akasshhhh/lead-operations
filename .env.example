APP_ENV=local
LOG_LEVEL=INFO
API_GATEWAY_PORT=8000
LEAD_SERVICE_AUTH_TOKEN=local-lead-service-token
LEAD_SERVICE_TIMEOUT_SECONDS=5

# Host-side connection settings for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_ai
POSTGRES_USER=voice_ai
POSTGRES_PASSWORD=voice_ai_dev_password
# Optional override; otherwise database clients derive a URL from POSTGRES_*.
# DATABASE_URL=postgresql+asyncpg://voice_ai:voice_ai_dev_password@localhost:5432/voice_ai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
EVENT_MAX_ATTEMPTS=5
EVENT_POLL_SECONDS=0.5

# Used only when running PostgreSQL integration tests.
# TEST_DATABASE_URL=postgresql+asyncpg://voice_ai:voice_ai_dev_password@localhost:5432/voice_ai_test
# TEST_REDIS_URL=redis://localhost:6379/15

# External provider credentials are intentionally optional during Module 1.
# Real provider integrations will be added in later modules.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPGRAM_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
