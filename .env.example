APP_ENV=local
LOG_LEVEL=INFO
API_GATEWAY_PORT=8000
LEAD_SERVICE_AUTH_TOKEN=local-lead-service-token
LEAD_SERVICE_TIMEOUT_SECONDS=5
CONVERSATION_SERVICE_TIMEOUT_SECONDS=5

# Host-side connection settings for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voice_ai
POSTGRES_USER=voice_ai
POSTGRES_PASSWORD=voice_ai_dev_password
# Optional override; otherwise database clients derive a URL from POSTGRES_*.
# DATABASE_URL=postgresql+asyncpg://voice_ai:voice_ai_dev_password@localhost:5432/voice_ai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
EVENT_MAX_ATTEMPTS=5
EVENT_POLL_SECONDS=0.5

# Used only when running PostgreSQL integration tests.
# TEST_DATABASE_URL=postgresql+asyncpg://voice_ai:voice_ai_dev_password@localhost:5432/voice_ai_test
# TEST_REDIS_URL=redis://localhost:6379/15

# LLM adapters/router (Module 9). Mock mode never calls a real provider.
LLM_MODE=mock
LLM_PROVIDERS=openai,openrouter
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_MAX_ATTEMPTS=2
LLM_ATTEMPT_TIMEOUT_SECONDS=4
LLM_RETRY_DELAY_SECONDS=0.1
LLM_FAILURE_THRESHOLD=3
LLM_COOLDOWN_SECONDS=15
# For LLM_MODE=real, supply a key for every enabled provider. Do not commit keys.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Speech adapters/router (Module 11). Real TTS requires explicit 24000 Hz PCM.
SPEECH_MODE=mock
STT_PROVIDERS=sarvam
TTS_PROVIDERS=sarvam,rumik
SARVAM_TTS_VOICE=shubh
RUMIK_TTS_MODEL=mulberry
RUMIK_TTS_VOICE=siya
SPEECH_MAX_ATTEMPTS=2
SPEECH_ATTEMPT_TIMEOUT_SECONDS=4
SPEECH_RETRY_DELAY_SECONDS=0.1
SPEECH_FAILURE_THRESHOLD=3
SPEECH_COOLDOWN_SECONDS=15
# For SPEECH_MODE=real, supply keys for each enabled provider.
# SARVAM_API_KEY=
# RUMIK_API_KEY=
